@startuml
title P2-2c framework - actual dependencies (working tree pending commit)
skinparam componentStyle rectangle
package "src/core (@svgframe/core)" as CORE {
  component "domain / local ChangeSet / subtree policies" as DOMAIN
  component "application / history / immutable queries" as APP
  component "extension contracts / registries" as CONTRACTS
  component "I/O + Directory + Construction ports" as PORTS
}
package "plugins/*" as PLUGINS {
  component "builtin-shapes" as SHAPES
  component "builtin-commands" as COMMANDS
}
package "src/host" as HOST {
  component "main / bootstrap" as MAIN
  component "composition (A)" as COMPOSE
  component "configuration + resolver + loader (B)" as LOADER
  component "PluginInstaller / staged registry / resources" as INSTALL
  component "CLI / generic formatters" as UI
  component "SVG + NodeDirectoryAdapter" as ADAPTERS
}
MAIN --> COMPOSE
MAIN --> UI
COMPOSE --> SHAPES : default class instances
COMPOSE --> COMMANDS : default class instances
COMPOSE --> INSTALL : A + defaults
COMPOSE --> LOADER : B
COMPOSE --> ADAPTERS
LOADER --> INSTALL : dynamic module export + manifest
LOADER ..> PLUGINS : generic dynamic import
INSTALL --> CONTRACTS
INSTALL --> APP
UI --> CONTRACTS
UI --> APP
ADAPTERS --> PORTS
ADAPTERS --> DOMAIN
SHAPES --> CONTRACTS
SHAPES --> DOMAIN
COMMANDS --> CONTRACTS
COMMANDS --> APP
COMMANDS --> DOMAIN
COMMANDS --> PORTS
APP --> CONTRACTS
APP --> DOMAIN
CONTRACTS --> DOMAIN
CONTRACTS ..> APP : command / result types
PORTS --> DOMAIN
note bottom of CORE
No Node / host / concrete plugin imports.
Plugin imports use only the public package root.
VSCode extension remains an independent package.
end note
@enduml
